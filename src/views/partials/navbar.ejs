<%
  const esColaborador = usuario.rol === 'COLABORADOR';
  const homeHref = esColaborador ? '/encuesta' : '/dashboard';
%>
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-3">
      <a href="<%= homeHref %>" class="inline-flex items-center gap-2 text-lg font-bold text-brand-700">
        <img
          src="/images/equiwork-icon.svg"
          alt=""
          class="ew-brand-icon"
          width="36"
          height="36"
        />
        EquiWork
      </a>
      <button
        type="button"
        id="navToggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 md:hidden"
        aria-expanded="false"
        aria-controls="navMenu"
        aria-label="Abrir menú"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>

    <nav
      id="navMenu"
      class="hidden flex-col gap-1 border-t border-slate-100 pb-4 pt-3 md:flex md:flex-row md:items-center md:justify-between md:border-t-0 md:py-0 md:pb-3"
    >
      <div class="flex flex-col gap-1 md:flex-row md:items-center">
        <% if (esColaborador) { %>
        <a data-nav="encuesta" class="ew-nav-link" href="/encuesta">Encuesta</a>
        <% } else { %>
        <a data-nav="dashboard" class="ew-nav-link" href="/dashboard">Dashboard</a>
        <a data-nav="colaboradores" class="ew-nav-link" href="/colaboradores">Colaboradores</a>
        <a data-nav="eventos" class="ew-nav-link" href="/eventos">Eventos</a>
        <a data-nav="reportes" class="ew-nav-link" href="/reportes">Reportes</a>
        <% } %>
      </div>
      <div class="mt-3 flex flex-col gap-2 md:mt-0 md:flex-row md:items-center">
        <span class="truncate text-xs text-slate-500 md:max-w-[14rem]">
          <%= usuario.nombre %> · <%= usuario.rol %>
        </span>
        <form action="/logout" method="post" class="m-0">
          <button type="submit" class="ew-btn-secondary w-full md:w-auto">Salir</button>
        </form>
      </div>
    </nav>
  </div>
</header>
