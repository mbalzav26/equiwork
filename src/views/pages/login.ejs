<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="ew-login-page">
    <div class="ew-login-shell">
      <aside class="ew-login-brand" aria-hidden="false">
        <div class="ew-login-brand-glow" aria-hidden="true"></div>
        <div class="ew-login-brand-glow-2" aria-hidden="true"></div>
        <div class="ew-login-brand-grid" aria-hidden="true"></div>

        <div class="ew-login-brand-inner">
          <div class="ew-login-logo">
            <img
              src="/images/equiwork-logo-light.svg"
              alt="EquiWork"
              class="ew-login-logo-img"
              width="200"
              height="44"
            />
          </div>

          <div>
            <p class="ew-login-brand-mobile-tag">Balance de carga laboral quincenal</p>
            <p class="ew-login-tagline">Balance de carga laboral, quincena a quincena.</p>
            <p class="ew-login-tagline-sub">
              Centraliza eventos, colaboradores y reportes en un solo lugar. Decisiones más
              claras para tu equipo.
            </p>
          </div>
        </div>

        <p class="ew-login-brand-footer">© <%= new Date().getFullYear() %> EquiWork</p>
      </aside>

      <section class="ew-login-form-panel">
        <div class="ew-login-form-inner">
          <header class="mb-8 lg:mt-0">
            <h1 class="ew-login-heading">Iniciar sesión</h1>
            <p class="ew-login-subheading">Ingresa con tu correo corporativo</p>
          </header>

          <% if (error) { %>
          <div class="ew-alert-error mb-6" role="alert"><%= error %></div>
          <% } %>

          <form method="post" action="/login" class="space-y-5" novalidate>
            <div>
              <label for="email" class="ew-label">Correo</label>
              <div class="ew-login-field">
                <span class="ew-login-field-icon" aria-hidden="true">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                    />
                  </svg>
                </span>
                <input
                  type="email"
                  class="ew-login-input"
                  id="email"
                  name="email"
                  required
                  autocomplete="username"
                  placeholder="tu@empresa.com"
                />
              </div>
            </div>

            <div>
              <label for="password" class="ew-label">Contraseña</label>
              <div class="ew-login-field">
                <span class="ew-login-field-icon" aria-hidden="true">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                    />
                  </svg>
                </span>
                <input
                  type="password"
                  class="ew-login-input"
                  id="password"
                  name="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                />
              </div>
            </div>

            <button type="submit" class="ew-login-submit">Ingresar</button>
          </form>

        </div>
      </section>
    </div>
    <%- include('../partials/scripts') %>
  </body>
</html>
