<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="flex min-h-screen items-center justify-center px-4">
    <main class="ew-card max-w-lg p-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Error</p>
      <h1 class="mt-2 text-5xl font-bold text-slate-900"><%= status || 500 %></h1>
      <p class="mt-3 text-slate-600"><%= message %></p>
      <a href="/dashboard" class="ew-btn-primary ew-btn-lg mt-8 inline-flex">Volver al inicio</a>
    </main>
  </body>
</html>
