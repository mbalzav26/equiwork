<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body data-page="encuesta">
    <%- include('../partials/app-shell-open', { usuario }) %>
    <main class="ew-container ew-page pb-24 lg:pb-8">
      <div class="ew-page-inner">
        <div class="ew-page-content w-full max-w-none" data-page-content>
      <div id="encAvisos" class="mb-4 hidden space-y-2"></div>

      <div class="mb-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Autoreporte quincenal</p>
        <h1 class="ew-page-title">Encuesta de actividades</h1>
        <p class="ew-page-subtitle">
          Registra tú mismo las tareas y horas de la quincena. Solo verás y editarás tu información.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3 mb-6">
        <div class="ew-kpi md:col-span-1">
          <p class="ew-kpi-label">Tus eventos</p>
          <p class="ew-kpi-value" id="encTotalEventos">0</p>
        </div>
        <div class="ew-kpi md:col-span-1">
          <p class="ew-kpi-label">Horas reportadas</p>
          <p class="ew-kpi-value" id="encTotalHoras">0 h</p>
        </div>
        <div class="ew-kpi md:col-span-1">
          <p class="ew-kpi-label">Quincena</p>
          <p class="mt-2 text-sm font-medium text-slate-800" id="encEtiquetaQuincena">—</p>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-12">
        <section class="ew-card lg:col-span-5 lg:sticky lg:top-24 lg:self-start">
          <div class="ew-card-header">
            <h2 class="text-base font-semibold text-slate-900">Agregar actividad</h2>
            <p class="mt-1 text-xs text-slate-500">Formulario corto para registrar tu jornada</p>
          </div>
          <div class="ew-card-body">
            <form id="formEncuesta" class="space-y-4">
              <div>
                <label for="encQuincena" class="ew-label">Quincena</label>
                <select id="encQuincena" class="ew-select" required></select>
                <p class="ew-help" id="encRangoQuincena"></p>
              </div>
              <div>
                <label for="encEmpresa" class="ew-label">Nombre de la empresa</label>
                <input
                  type="text"
                  id="encEmpresa"
                  class="ew-input"
                  maxlength="120"
                  required
                  placeholder="Empresa o cliente donde realizaste la actividad"
                />
              </div>
              <div>
                <label for="encDireccion" class="ew-label">Dirección</label>
                <input
                  type="text"
                  id="encDireccion"
                  class="ew-input"
                  maxlength="255"
                  required
                  placeholder="Dirección del lugar de trabajo"
                />
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="encFecha" class="ew-label">Fecha</label>
                  <input type="date" id="encFecha" class="ew-input" required />
                </div>
                <div>
                  <label for="encHoras" class="ew-label">Horas</label>
                  <input
                    type="number"
                    step="0.25"
                    min="0.25"
                    max="24"
                    id="encHoras"
                    class="ew-input"
                    required
                  />
                </div>
              </div>
              <div>
                <label for="encTipo" class="ew-label">Tipo de actividad</label>
                <select id="encTipo" class="ew-select" required>
                  <option value="">Cargando tipos…</option>
                </select>
                <p id="encTipoAyuda" class="ew-help mt-1.5 hidden rounded-lg bg-brand-50/80 px-2.5 py-2 text-brand-800"></p>
              </div>
              <div>
                <label for="encDescripcion" class="ew-label">¿Qué realizaste?</label>
                <input
                  type="text"
                  id="encDescripcion"
                  class="ew-input"
                  maxlength="255"
                  required
                  placeholder="Describe brevemente la actividad"
                />
              </div>
              <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3">
                <input
                  type="checkbox"
                  id="encAuxilioTransporte"
                  class="mt-1 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
                />
                <label for="encAuxilioTransporte" class="cursor-pointer text-sm font-medium text-slate-800">
                  Auxilio de transporte
                </label>
              </div>
              <div id="encComentariosTransporteWrap" class="hidden space-y-1">
                <label for="encComentariosTransporte" class="ew-label">Comentarios (auxilio de transporte)</label>
                <textarea
                  id="encComentariosTransporte"
                  class="ew-input min-h-[88px] resize-y"
                  maxlength="500"
                  rows="3"
                  placeholder="Detalle del desplazamiento, valor estimado u observaciones"
                ></textarea>
              </div>
              <button type="submit" class="ew-btn-primary ew-btn-lg hidden w-full lg:flex" id="btnGuardarEncuesta">
                Enviar actividad
              </button>
            </form>
          </div>
        </section>

        <section class="ew-card lg:col-span-7">
          <div class="ew-card-header flex flex-wrap items-start justify-between gap-3">
            <div>
              <h2 class="text-base font-semibold text-slate-900">Mis registros</h2>
              <p class="mt-1 text-xs text-slate-500">Historial de la quincena seleccionada</p>
            </div>
            <button type="button" class="ew-btn-secondary" id="btnRefrescarEncuesta">Actualizar</button>
          </div>
          <div class="ew-card-body relative min-h-[10rem]">
            <%- include('../partials/page-loading', { id: 'encLoading', scope: 'section' }) %>
            <ul class="divide-y divide-slate-100" id="listaEncuesta"></ul>
          </div>
        </section>
      </div>

      <div
        class="fixed inset-x-0 bottom-0 z-30 border-t border-slate-200 bg-white/95 p-4 backdrop-blur pb-[max(1rem,env(safe-area-inset-bottom))] lg:hidden"
      >
        <button type="submit" form="formEncuesta" class="ew-btn-primary ew-btn-lg w-full">
          Enviar actividad
        </button>
      </div>
        </div>
      </div>
    </main>
    <%- include('../partials/app-shell-close') %>
    <%- include('../partials/scripts') %>
    <script src="/js/tiposActividad.js"></script>
    <script src="/js/encuesta.js"></script>
  </body>
</html>
