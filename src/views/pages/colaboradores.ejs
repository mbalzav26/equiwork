<!DOCTYPE html>
<html lang="es">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body data-page="colaboradores">
    <%- include('../partials/app-shell-open', { usuario }) %>
    <main class="ew-container ew-page">
      <div class="ew-page-inner">
        <%- include('../partials/page-loading', { id: 'colabLoading', scope: 'page' }) %>
        <div class="ew-page-content" data-page-content>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 class="ew-page-title">Colaboradores</h1>
          <p class="ew-page-subtitle">Alta, edición y acceso a encuesta para pruebas de autoreporte</p>
        </div>
        <button type="button" class="ew-btn-primary ew-btn-lg w-full sm:w-auto" id="btnNuevoColaborador">
          Nuevo colaborador
        </button>
      </div>

      <div class="rounded-2xl border border-brand-100 bg-brand-50/70 px-4 py-3 text-sm text-slate-700">
        Para probar <strong>Encuesta</strong>, crea el usuario COLABORADOR desde la tabla (o al dar de alta).
        Contraseña temporal por defecto: <code class="rounded bg-white px-1.5 py-0.5">Colab123!</code> — en el primer
        inicio de sesión deberán definir una nueva.
      </div>

      <% if (usuario.roles && usuario.roles.includes('ADMINISTRADOR')) { %>
      <div class="mt-4 w-full max-w-sm">
        <label class="ew-label mb-1 text-xs" for="colabBuscar">Buscar colaborador</label>
        <input
          type="search"
          id="colabBuscar"
          class="ew-input min-h-9 py-2 text-sm"
          placeholder="Nombre o documento..."
          autocomplete="off"
          spellcheck="false"
        />
        <p class="mt-1 text-xs text-slate-500" id="colabBuscarHint" aria-live="polite"></p>
      </div>
      <% } %>

      <section class="ew-card mt-4">
        <div class="ew-table-wrap">
          <table class="ew-table" id="tablaColaboradores">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Correo</th>
                <th>Cargo</th>
                <th>Área</th>
                <th>Encuesta</th>
                <th class="text-right">Acciones</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
        </div>
      </div>
    </main>

    <div
      id="modalColaborador"
      class="hidden fixed inset-0 z-50 flex items-end justify-center p-4 sm:items-center"
      data-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalColaboradorTitulo"
    >
      <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-[2px]" data-modal-backdrop></div>
      <div class="relative w-full max-w-lg rounded-2xl bg-white shadow-2xl">
        <form id="formColaborador">
          <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
            <h2 class="text-lg font-semibold text-slate-900" id="modalColaboradorTitulo">
              Nuevo colaborador
            </h2>
            <button type="button" class="ew-btn-secondary min-h-10 px-3 py-2" data-modal-close>
              Cerrar
            </button>
          </div>
          <div class="space-y-4 px-5 py-5">
            <input type="hidden" id="colabId" />
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="ew-label" for="colabNombres">Nombres</label>
                <input class="ew-input" id="colabNombres" required />
              </div>
              <div>
                <label class="ew-label" for="colabApellidos">Apellidos</label>
                <input class="ew-input" id="colabApellidos" required />
              </div>
            </div>
            <div>
              <label class="ew-label" for="colabEmail">Correo</label>
              <input type="email" class="ew-input" id="colabEmail" required />
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="ew-label" for="colabTipoDoc">Tipo de documento</label>
                <select id="colabTipoDoc" class="ew-select" required>
                  <option value="CC">Cédula de ciudadanía (CC)</option>
                  <option value="CE">Cédula de extranjería (CE)</option>
                  <option value="TI">Tarjeta de identidad (TI)</option>
                  <option value="PA">Pasaporte (PA)</option>
                  <option value="PPT">Permiso por protección temporal (PPT)</option>
                  <option value="RC">Registro civil (RC)</option>
                </select>
              </div>
              <div>
                <label class="ew-label" for="colabNumDoc">Número de documento</label>
                <input class="ew-input" id="colabNumDoc" required maxlength="20" placeholder="Ej. 1032456789" />
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="ew-label" for="colabCargo">Cargo</label>
                <input class="ew-input" id="colabCargo" value="recreador" required />
              </div>
              <div>
                <label class="ew-label" for="colabArea">Área</label>
                <input class="ew-input" id="colabArea" required />
              </div>
            </div>
            <div id="bloqueCuentaEncuesta" class="rounded-xl border border-slate-200 bg-slate-50 p-4">
              <label class="flex items-start gap-3">
                <input type="checkbox" id="colabCrearCuenta" class="mt-1 h-4 w-4 rounded border-slate-300" checked />
                <span>
                  <span class="block text-sm font-medium text-slate-800">Crear usuario de acceso al sistema</span>
                  <span class="block text-xs text-slate-500">Usará el mismo correo del colaborador para iniciar sesión.</span>
                </span>
              </label>
              <fieldset class="mt-4 space-y-2" id="bloqueRolCuenta">
                <legend class="ew-label mb-1">Roles del usuario (puede elegir ambos)</legend>
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm">
                  <input type="checkbox" id="colabRolColaborador" class="h-4 w-4 rounded border-slate-300" checked />
                  <span>
                    <span class="font-medium text-slate-800">Colaborador</span>
                    <span class="block text-xs text-slate-500">Acceso a encuesta y autoreporte.</span>
                  </span>
                </label>
                <% if (usuario.roles && usuario.roles.includes('ADMINISTRADOR')) { %>
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-brand-200 bg-brand-50/50 px-3 py-2.5 text-sm">
                  <input type="checkbox" id="colabRolAdmin" class="h-4 w-4 rounded border-slate-300" />
                  <span>
                    <span class="font-medium text-slate-800">Administrador</span>
                    <span class="block text-xs text-slate-500">Permisos de administración del sistema.</span>
                  </span>
                </label>
                <% } %>
              </fieldset>
              <div class="mt-3">
                <label class="ew-label" for="colabPasswordEncuesta">Contraseña temporal</label>
                <input
                  type="text"
                  class="ew-input"
                  id="colabPasswordEncuesta"
                  value="Colab123!"
                  minlength="8"
                />
              </div>
            </div>
          </div>
          <div class="flex flex-col-reverse gap-2 border-t border-slate-100 px-5 py-4 sm:flex-row sm:justify-end">
            <button type="button" class="ew-btn-secondary ew-btn-lg" data-modal-close>Cancelar</button>
            <button type="submit" class="ew-btn-primary ew-btn-lg">Guardar</button>
          </div>
        </form>
      </div>
    </div>

    <%- include('../partials/app-shell-close') %>
    <%- include('../partials/scripts') %>
    <script>
      window.EQUIWORK_USER_ROL = '<%= usuario.rol %>';
      window.EQUIWORK_USER_ES_ADMIN = <%= usuario.roles && usuario.roles.includes('ADMINISTRADOR') ? 'true' : 'false' %>;
    </script>
    <script src="/js/colaboradores.js"></script>
  </body>
</html>
