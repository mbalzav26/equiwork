{
  "name": "equiwork",
  "version": "1.0.0",
  "description": "Sistema web para gestión de colaboradores y balance de carga laboral quincenal",
  "main": "src/server.js",
  "scripts": {
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/css/equiwork.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/equiwork.css --watch",
    "start": "node src/server.js",
    "dev": "npm run css:build && node --watch src/server.js",
    "db:sync": "node src/scripts/syncDatabase.js",
    "db:seed": "node src/scripts/seedDatabase.js",
    "db:seed:production": "node src/scripts/seedProduction.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.8",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "tailwindcss": "^4.1.8"
  }
}
