NODE_ENV=development
PORT=3000

# sqlite (sin instalar MySQL) | mysql (producción)
DB_DIALECT=sqlite
DB_STORAGE=database/equiwork.sqlite

DB_HOST=localhost
DB_PORT=3306
DB_NAME=equiwork
DB_USER=root
DB_PASSWORD=

SESSION_SECRET=cambiar-por-secreto-seguro-en-produccion
JWT_SECRET=cambiar-jwt-secreto-en-produccion
JWT_EXPIRES_IN=8h

# Producción / Render — administrador inicial (bootstrap al arrancar)
ADMIN_INITIAL_EMAIL=admin@equiwork.local
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Administrador

# Seed manual: development | production
SEED_PROFILE=development
